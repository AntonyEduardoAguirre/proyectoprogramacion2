}
QLabel#eyebrow {
	color: #92918B;
	font-family: &quot;Segoe UI&quot;;
	font-size: 11px;
	font-weight: 600;
}
QLabel#title {
	color: #292A28;
	font-family: Georgia;
	font-size: 29px;
}
QLabel#subtitle, QLabel#copyright {
	color: #92918B;
	font-family: &quot;Segoe UI&quot;;
	font-size: 12px;
}
QLabel#lblUsuario, QLabel#lblSaldo, QLabel#lblId {
	color: #292A28;
	background: #FAFAF8;
	border: 1px solid #EAE8E2;
	border-radius: 8px;
	padding: 14px;
	font-size: 13px;
}
QPushButton#btnHistorial, QPushButton#btnCambiar {
	background: #899B83;
	color: #FFFFFF;
	border: none;
	border-radius: 8px;
	min-height: 43px;
	font-weight: 600;
}
QPushButton#btnHistorial:hover, QPushButton#btnCambiar:hover {
	background: #788B72;
}
QPushButton#btnDesactivar {
	background: #92918B;
	color: #FFFFFF;
	border: none;
	border-radius: 8px;
	min-height: 43px;
	font-weight: 600;
}
QPushButton#btnDesactivar:hover {
	background: #7D7C77;
}
QPushButton#btnRegresar {
	background: transparent;
	border: none;
	color: #899B83;
	padding: 5px;
}
QPushButton#btnRegresar:hover {
	color: #788B72;
}
</string>
