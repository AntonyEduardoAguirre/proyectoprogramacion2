  <property name="styleSheet">
   <string notr="true">QMainWindow, #centralwidget {
	background-color: #FFFFFF;
	font-family: "Segoe UI";
	font-size: 12px;
}
#cardFiltros, #cardCatalogo {
	background: transparent;
	border: none;
}
#cardDetalle {
	background-color: #FFFFFF;
	border: 1px solid #EAE8E2;
	border-radius: 18px;
}
QLabel#eyebrowFiltros, QLabel#eyebrowCatalogo, QLabel#eyebrowDetalle {
	color: #92918B;
	font-family: "Segoe UI";
	font-size: 11px;
	font-weight: 600;
}
QLabel#titleFiltros {
	color: #292A28;
	font-family: "Segoe UI";
	font-size: 17px;
	font-weight: 600;
}
QLabel#titleCatalogo {
	color: #292A28;
	font-family: "Segoe UI";
	font-size: 22px;
	font-weight: 600;
}
QLabel#titleDetalle {
	color: #292A28;
	font-family: "Segoe UI";
	font-size: 24px;
	font-weight: 600;
}
QLabel#subtitleFiltros, QLabel#subtitleCatalogo, QLabel#subtitleDetalle,
QLabel#copyrightMenu, QLabel#copyrightDetalle, QLabel#lblPagina {
	color: #92918B;
	font-family: "Segoe UI";
	font-size: 11px;
}
QCheckBox {
	color: #5F5E59;
	font-family: "Segoe UI";
	font-size: 11px;
	font-weight: 600;
	spacing: 7px;
}
QCheckBox::indicator {
	width: 13px;
	height: 13px;
	border: 1px solid #DEDDD6;
	border-radius: 3px;
	background: #FFFFFF;
}
QCheckBox::indicator:checked {
	background: #2D5043;
	border-color: #2D5043;
}
QLineEdit {
	background-color: #F9F9F6;
	color: #292A28;
	border: 1px solid #ECEBE5;
	border-radius: 8px;
	padding: 0 12px;
	min-height: 36px;
	font-family: "Segoe UI";
	font-size: 12px;
}
QLineEdit:focus {
	border: 1px solid #2D5043;
}
QLineEdit:disabled {
	background-color: #F6F5F1;
	color: #B5B4AE;
	border: 1px solid #EFEEE9;
}
QSlider::groove:horizontal {
	height: 4px;
	background: #E8E7E1;
	border-radius: 2px;
}
QSlider::sub-page:horizontal {
	background: #2D5043;
	border-radius: 2px;
}
QSlider::handle:horizontal {
	background: #FFFFFF;
	border: 2px solid #2D5043;
	width: 14px;
	height: 14px;
	margin: -7px 0;
	border-radius: 9px;
}
QSlider::groove:horizontal:disabled {
	background: #EFEEE9;
}
QSlider::sub-page:horizontal:disabled {
	background: #D5D9D2;
}
QSlider::handle:horizontal:disabled {
	border-color: #C9CCC5;
}
QLabel#lblPrecio {
	color: #292A28;
	font-family: Georgia;
	font-size: 22px;
}
QPushButton#btnProducto {
	background-color: #FAFAF8;
	color: #292A28;
	border: 1px solid #EAE8E2;
	border-radius: 12px;
	padding: 10px;
	font-family: "Segoe UI";
	font-size: 11px;
	font-weight: 600;
}
QPushButton#btnProducto:hover {
	background-color: #F4F7F3;
	border-color: #2D5043;
}
QPushButton#btnAnterior, QPushButton#btnSiguiente, QPushButton#btnRegresar, QPushButton#btnSalir {
	background: #FFFFFF;
	color: #292A28;
	border: 1px solid #E8E7E1;
	border-radius: 8px;
	min-height: 34px;
	padding: 0 16px;
	font-family: "Segoe UI";
	font-size: 12px;
	font-weight: 600;
}
QPushButton#btnAnterior:hover, QPushButton#btnSiguiente:hover, QPushButton#btnRegresar:hover, QPushButton#btnSalir:hover {
	background: #F7F7F4;
	border-color: #D8D7D0;
}
QPushButton#btnAnterior:disabled, QPushButton#btnSiguiente:disabled {
	color: #B5B4AE;
	border-color: #EFEEE9;
}
QPushButton#btnCarrito {
	background: #2D5043;
	color: #FFFFFF;
	border: none;
	border-radius: 8px;
	min-height: 36px;
	font-family: "Segoe UI";
	font-size: 12px;
	font-weight: 600;
}
QPushButton#btnCarrito:hover {
	background: #244238;
}
QPushButton#btnCarrito:pressed {
	background: #1D372E;
}
QPushButton#btnComprar {
	background: #2D5043;
	color: #FFFFFF;
	border: none;
	border-radius: 8px;
	min-height: 42px;
	font-family: "Segoe UI";
	font-size: 12px;
	font-weight: 600;
}
QPushButton#btnComprar:hover {
	background: #244238;
}
QPushButton#btnComprar:pressed {
	background: #1D372E;
}
QLabel#lblDetNombre, QLabel#lblDetCategoria, QLabel#lblDetPrecio,
QLabel#lblDetId, QLabel#lblDetStock {
	color: #292A28;
	background: #FAFAF8;
	border: 1px solid #EAE8E2;
	border-radius: 8px;
	padding: 12px;
	font-size: 13px;
}

 QScrollArea#scrollCarritoPanel {
 	background: transparent;
 	border: none;
 }
 QWidget#areaCarritoPanel {
 	background: transparent;
 }
 QLabel#lblCarritoVacio, QLabel#lblItemCarritoPanel {
 	color: #292A28;
 	background: #FAFAF8;
 	border: 1px solid #EAE8E2;
 	border-radius: 8px;
 	padding: 14px;
 	font-family: "Segoe UI";
 	font-size: 13px;
 }
 QLabel#lblCarritoVacio {
 	color: #92918B;
 }
 QLabel#lblTituloTotalPanel {
 	color: #92918B;
 	font-family: "Segoe UI";
 	font-size: 11px;
 }
 QLabel#lblTotalPanel {
 	color: #292A28;
 	font-family: Georgia;
 	font-size: 22px;
 }
</string>
