  <property name="styleSheet">
   <string notr="true">QMainWindow, #centralwidget {
	background-color: #F5F3EE;
}
#cardFiltros, #cardCatalogo, #cardDetalle {
	background-color: #FFFFFF;
	border: 1px solid #EAE8E2;
	border-radius: 18px;
}
QLabel#eyebrowFiltros, QLabel#eyebrowCatalogo, QLabel#eyebrowDetalle {
	color: #92918B;
	font-family: "Segoe UI";
	font-size: 11px;
	font-weight: 600;
}
QLabel#titleFiltros {
	color: #292A28;
	font-family: Georgia;
	font-size: 24px;
}
QLabel#titleCatalogo, QLabel#titleDetalle {
	color: #292A28;
	font-family: Georgia;
	font-size: 29px;
}
QLabel#subtitleFiltros, QLabel#subtitleCatalogo, QLabel#subtitleDetalle,
QLabel#copyrightMenu, QLabel#copyrightDetalle, QLabel#lblPagina {
	color: #92918B;
	font-family: "Segoe UI";
	font-size: 12px;
}
QCheckBox {
	color: #292A28;
	font-family: "Segoe UI";
	font-size: 12px;
	font-weight: 600;
	spacing: 8px;
}
QCheckBox::indicator {
	width: 14px;
	height: 14px;
	border: 1px solid #E8E7E1;
	border-radius: 3px;
	background: #FAFAF8;
}
QCheckBox::indicator:checked {
	background: #899B83;
	border-color: #899B83;
}
QLineEdit {
	background-color: #FAFAF8;
	color: #292A28;
	border: 1px solid #E8E7E1;
	border-radius: 8px;
	padding: 0 12px;
	min-height: 40px;
	font-size: 13px;
}
QLineEdit:focus {
	border: 1px solid #899B83;
}
QLineEdit:disabled {
	background-color: #F6F5F1;
	color: #B5B4AE;
	border: 1px solid #EFEEE9;
}
QSlider::groove:horizontal {
	height: 4px;
	background: #E8E7E1;
	border-radius: 2px;
}
QSlider::sub-page:horizontal {
	background: #899B83;
	border-radius: 2px;
}
QSlider::handle:horizontal {
	background: #FFFFFF;
	border: 2px solid #899B83;
	width: 14px;
	height: 14px;
	margin: -7px 0;
	border-radius: 9px;
}
QSlider::groove:horizontal:disabled {
	background: #EFEEE9;
}
QSlider::sub-page:horizontal:disabled {
	background: #D5D9D2;
}
QSlider::handle:horizontal:disabled {
	border-color: #C9CCC5;
}
QLabel#lblPrecio {
	color: #899B83;
	font-family: "Segoe UI";
	font-size: 13px;
	font-weight: 600;
}
QPushButton#btnProducto {
	background-color: #FAFAF8;
	color: #292A28;
	border: 1px solid #EAE8E2;
	border-radius: 12px;
	padding: 12px;
	font-family: "Segoe UI";
	font-size: 13px;
	font-weight: 600;
}
QPushButton#btnProducto:hover {
	background-color: #F4F7F3;
	border-color: #899B83;
}
QPushButton#btnAnterior, QPushButton#btnSiguiente, QPushButton#btnSalir, QPushButton#btnCarrito {
	background: #FAFAF8;
	color: #292A28;
	border: 1px solid #E8E7E1;
	border-radius: 8px;
	min-height: 38px;
	padding: 0 16px;
	font-family: "Segoe UI";
	font-weight: 600;
}
QPushButton#btnAnterior:hover, QPushButton#btnSiguiente:hover, QPushButton#btnSalir:hover, QPushButton#btnCarrito:hover {
	border-color: #899B83;
	color: #899B83;
}
QPushButton#btnAnterior:disabled, QPushButton#btnSiguiente:disabled {
	color: #B5B4AE;
	border-color: #EFEEE9;
}
QPushButton#btnComprar {
	background: #899B83;
	color: #FFFFFF;
	border: none;
	border-radius: 8px;
	min-height: 43px;
	font-family: "Segoe UI";
	font-weight: 600;
}
QPushButton#btnComprar:hover {
	background: #788B72;
}
QLabel#lblDetNombre, QLabel#lblDetCategoria, QLabel#lblDetPrecio,
QLabel#lblDetId, QLabel#lblDetStock {
	color: #292A28;
	background: #FAFAF8;
	border: 1px solid #EAE8E2;
	border-radius: 8px;
	padding: 12px;
	font-size: 13px;
}
</string>
