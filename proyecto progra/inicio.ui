   <string notr="true">QMainWindow, #centralWidget {
	background-color: #F5F3EE;
}
#loginCard {
	background-color: #FFFFFF;
	border: 1px solid #EAE8E2;
	border-radius: 18px;
}
QLabel#eyebrow {
	color: #92918B;
	font-family: &quot;Segoe UI&quot;;
	font-size: 11px;
	font-weight: 600;
}
QLabel#title {
	color: #292A28;
	font-family: Georgia;
	font-size: 29px;
	font-weight: 400;
}
QLabel#subtitle, QLabel#copyright {
	color: #92918B;
	font-family: &quot;Segoe UI&quot;;
	font-size: 12px;
}
QLabel#lblNombre, QLabel#lblContrasenna {
	color: #292A28;
	font-family: &quot;Segoe UI&quot;;
	font-size: 12px;
	font-weight: 600;
	margin-bottom: 6px;
}
QLineEdit {
	background-color: #FAFAF8;
	color: #292A28;
	border: 1px solid #E8E7E1;
	border-radius: 8px;
	font-family: &quot;Segoe UI&quot;;
	font-size: 13px;
	padding: 0 13px;
	min-height: 46px;
}
QLineEdit:focus {
	border: 1px solid #899B83;
}
QCheckBox {
	color: #92918B;
	font-family: &quot;Segoe UI&quot;;
	font-size: 11px;
}
QCheckBox::indicator {
	width: 13px;
	height: 13px;
	border: 1px solid #E8E7E1;
	border-radius: 3px;
	background: #FAFAF8;
}
QCheckBox::indicator:checked {
	background: #899B83;
	border-color: #899B83;
}
QPushButton#btnIniciarSesion {
	background-color: #899B83;
	color: #FFFFFF;
	border: none;
	border-radius: 8px;
	font-family: &quot;Segoe UI&quot;;
	font-size: 13px;
	font-weight: 600;
	min-height: 49px;
}
QPushButton#btnIniciarSesion:hover { background-color: #788B72; }
QPushButton#btnIniciarSesion:pressed { background-color: #6D8067; }
QPushButton#btnRegistrarse, QPushButton#btnCuentaAdmin, QPushButton#btnRecuperar, QPushButton#btnSalir {
	background: transparent;
	border: none;
	color: #899B83;
	font-family: &quot;Segoe UI&quot;;
	font-size: 11px;
	padding: 4px;
}
QPushButton#btnRegistrarse:hover, QPushButton#btnCuentaAdmin:hover, QPushButton#btnRecuperar:hover, QPushButton#btnSalir:hover {
	color: #788B72;
}
QLabel#lblError { color: #92918B; font-size: 11px; margin-top: 8px; }
</string>
