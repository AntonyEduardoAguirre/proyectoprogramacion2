   <string notr="true">#VentanaDetalleCuotaClass {
	background-color: #F5F3EE;
}
#softCard {
	background-color: #FFFFFF;
	border: 1px solid #EAE8E2;
	border-radius: 18px;
}
QLabel#eyebrow {
	color: #92918B;
	font-family: &quot;Segoe UI&quot;;
	font-size: 11px;
	font-weight: 600;
}
QLabel#title {
	color: #292A28;
	font-family: Georgia;
	font-size: 29px;
}
QLabel#subtitle {
	color: #92918B;
	font-family: &quot;Segoe UI&quot;;
	font-size: 12px;
}
QLabel[tipo=&quot;dato&quot;] {
	color: #292A28;
	background: #FAFAF8;
	border: 1px solid #EAE8E2;
	border-radius: 8px;
	padding: 11px 14px;
	font-family: &quot;Segoe UI&quot;;
	font-size: 13px;
}
QLabel[tipo=&quot;total&quot;] {
	color: #292A28;
	background: #FAFAF8;
	border: 1px solid #EAE8E2;
	border-radius: 8px;
	padding: 12px 14px;
	font-family: &quot;Segoe UI&quot;;
	font-size: 14px;
	font-weight: 600;
}
QLabel#lblFaltaPagar { color: #FFFFFF; background-color: #899B83; border: none; border-radius: 8px; padding: 12px 14px; font-family: &quot;Segoe UI&quot;; font-size: 15px; font-weight: 700; }
QLabel[tipo=&quot;seccion&quot;] {
	color: #292A28;
	font-family: &quot;Segoe UI&quot;;
	font-size: 13px;
	font-weight: 600;
	padding: 4px 0;
}
QLabel#lblEstadoPago {
	color: #92918B;
	font-family: &quot;Segoe UI&quot;;
	font-size: 11px;
}
QLabel#lblEstadoPago[error=&quot;true&quot;] {
	color: #B3261E;
}
QListWidget#listaProductos {
	background: #FAFAF8;
	border: 1px solid #EAE8E2;
	border-radius: 8px;
	padding: 6px;
	font-family: &quot;Segoe UI&quot;;
	font-size: 12px;
	color: #292A28;
	outline: none;
}
QListWidget#listaProductos::item {
	padding: 7px 8px;
	border-radius: 5px;
}
QListWidget#listaProductos::item:selected {
	background: #E5EAE2;
	color: #292A28;
}
QScrollArea {
	background: transparent;
	border: none;
}
QScrollArea &gt; QWidget &gt; QWidget {
	background: transparent;
}
QScrollBar:vertical {
	background: transparent;
	width: 8px;
	margin: 0;
}
QScrollBar::handle:vertical {
	background: #D8DED5;
	border-radius: 4px;
	min-height: 30px;
}
QScrollBar::handle:vertical:hover {
	background: #B9C2B4;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
	height: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
	background: transparent;
}
QScrollBar:horizontal {
	background: transparent;
	height: 0;
}
QPushButton#btnCompletarPago {
	background: #899B83;
	color: #FFFFFF;
	border: none;
	border-radius: 8px;
	min-height: 43px;
	font-family: &quot;Segoe UI&quot;;
	font-size: 13px;
	font-weight: 600;
}
QPushButton#btnCompletarPago:hover {
	background: #788B72;
}
QPushButton#btnCompletarPago:pressed {
	background: #6D8067;
}
QPushButton#btnCompletarPago:disabled {
	background: #D5DAD2;
	color: #FAFAF8;
}
QPushButton#btnRegresar {
	background-color: #FFFFFF;
	color: #899B83;
	border: 1px solid #899B83;
	border-radius: 8px;
	min-height: 43px;
	font-family: &quot;Segoe UI&quot;;
	font-size: 13px;
	font-weight: 600;
}
QPushButton#btnRegresar:hover {
	background-color: #F0F3EE;
	color: #788B72;
}
QPushButton#btnRegresar:pressed {
	background-color: #E5EAE2;
}
