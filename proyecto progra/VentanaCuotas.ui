   <string notr="true">#VentanaCuotasClass {
	background-color: #F5F3EE;
}
#softCard {
	background-color: #FFFFFF;
	border: 1px solid #EAE8E2;
	border-radius: 18px;
}
QLabel#eyebrow {
	color: #92918B;
	font-family: &quot;Segoe UI&quot;;
	font-size: 11px;
	font-weight: 600;
}
QLabel#title {
	color: #292A28;
	font-family: Georgia;
	font-size: 29px;
}
QLabel#subtitle {
	color: #92918B;
	font-family: &quot;Segoe UI&quot;;
	font-size: 12px;
}
QLabel#lblEstado {
	color: #92918B;
	font-family: &quot;Segoe UI&quot;;
	font-size: 12px;
}
QLabel#lblEstado[error=&quot;true&quot;] {
	color: #B3261E;
}
QLineEdit {
	background-color: #FAFAF8;
	color: #292A28;
	border: 1px solid #E8E7E1;
	border-radius: 8px;
	font-family: &quot;Segoe UI&quot;;
	font-size: 14px;
	padding: 0 13px;
	min-height: 43px;
}
QLineEdit:focus {
	border: 1px solid #899B83;
}
QTabWidget::pane {
	background: #FAFAF8;
	border: 1px solid #EAE8E2;
	border-radius: 10px;
}
QTabBar::tab {
	background: #F0F3EE;
	color: #92918B;
	border-radius: 8px;
	padding: 8px 16px;
	font-family: &quot;Segoe UI&quot;;
	font-size: 12px;
	font-weight: 600;
}
QTabBar::tab:selected {
	background: #899B83;
	color: #FFFFFF;
}
QListWidget#listaCuotas, QListWidget#listaCompletadas {
	background: #FAFAF8;
	border: none;
	border-radius: 10px;
	padding: 6px;
	font-family: &quot;Segoe UI&quot;;
	font-size: 13px;
	color: #292A28;
	outline: none;
}
QListWidget#listaCuotas::item, QListWidget#listaCompletadas::item {
	padding: 12px 10px;
	border-radius: 6px;
}
QListWidget#listaCuotas::item:hover, QListWidget#listaCuotas::item:selected,
QListWidget#listaCompletadas::item:hover, QListWidget#listaCompletadas::item:selected {
	background: #E5EAE2;
	color: #292A28;
}
QPushButton#btnRegresar {
	background-color: #FFFFFF;
	color: #899B83;
	border: 1px solid #899B83;
	border-radius: 8px;
	min-height: 43px;
	font-family: &quot;Segoe UI&quot;;
	font-size: 13px;
	font-weight: 600;
}
QPushButton#btnRegresar:hover {
	background-color: #F0F3EE;
	color: #788B72;
}
QPushButton#btnRegresar:pressed {
	background-color: #E5EAE2;
}
</string>
