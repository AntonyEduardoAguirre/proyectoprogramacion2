  <property name="styleSheet">
   <string notr="true">QMainWindow, #centralwidget {
	background-color: #FFFFFF;
}
#cardCarrito, #cardCatalogo {
	background: transparent;
	border: none;
}
QLabel#lblPagina, QLabel#lblCarritoVacio {
	color: #92918B;
	font-family: "Segoe UI";
	font-size: 11px;
}
QLineEdit {
	background-color: #FAFAF8;
	color: #292A28;
	border: 1px solid #E8E7E1;
	border-radius: 8px;
	padding: 0 12px;
	min-height: 36px;
	font-family: "Segoe UI";
	font-size: 13px;
}
QLineEdit:focus {
	border: 1px solid #899B83;
}
QPushButton#btnProducto {
	background-color: #FAFAF8;
	border: 1px solid #EAE8E2;
	border-radius: 12px;
	padding: 0;
}
QPushButton#btnProducto:hover {
	background-color: #F4F7F3;
	border-color: #899B83;
}
QPushButton#btnProducto QLabel {
	background: transparent;
	border: none;
	font-family: "Segoe UI";
}
QLabel#prodNombre, QLabel#prodPrecio, QLabel#prodCodigo {
	color: #292A28;
	font-size: 12px;
}
QPushButton#btnAnterior, QPushButton#btnSiguiente {
	background: #FFFFFF;
	color: #292A28;
	border: 1px solid #E8E7E1;
	border-radius: 8px;
	min-height: 34px;
	padding: 0 16px;
	font-family: "Segoe UI";
	font-weight: 600;
}
QPushButton#btnAnterior:hover, QPushButton#btnSiguiente:hover {
	border-color: #899B83;
	color: #899B83;
}
QPushButton#btnAnterior:disabled, QPushButton#btnSiguiente:disabled {
	background: #FAFAF8;
	color: #B5B4AE;
	border-color: #EFEEE9;
}
QPushButton#btnPagar {
	background: #2F5243;
	color: #FFFFFF;
	border: none;
	border-radius: 8px;
	min-height: 36px;
	font-family: "Segoe UI";
	font-size: 13px;
	font-weight: 700;
}
QPushButton#btnPagar:hover {
	background: #264135;
}
QPushButton#btnRegresar {
	background: transparent;
	color: #899B83;
	border: none;
	min-height: 32px;
	font-family: "Segoe UI";
	font-size: 13px;
}
QPushButton#btnRegresar:hover {
	color: #2F5243;
}
QPushButton#btnPagar:disabled {
	background: #C9D2CD;
	color: #F5F3EE;
}
#scrollCarrito, #scrollCarrito &gt; QWidget &gt; QWidget {
	background: transparent;
	border: none;
}
QScrollBar:vertical {
	background: transparent;
	width: 8px;
	margin: 0;
}
QScrollBar::handle:vertical {
	background: #E0DED7;
	border-radius: 4px;
	min-height: 24px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
	height: 0;
}
QFrame#itemCarrito {
	background-color: #FAFAF8;
	border: 1px solid #EAE8E2;
	border-radius: 12px;
}
QFrame#itemCarrito QLabel {
	background: transparent;
	border: none;
	font-family: "Segoe UI";
}
QLabel#itemNombre {
	color: #292A28;
	font-size: 13px;
	font-weight: 600;
}
QLabel#itemCantidad {
	color: #292A28;
	font-size: 13px;
	min-width: 22px;
}
QLabel#itemSubtotal {
	color: #92918B;
	font-size: 13px;
}
QPushButton#btnCantidad {
	background: #FFFFFF;
	color: #292A28;
	border: 1px solid #E8E7E1;
	border-radius: 8px;
	min-width: 28px;
	max-width: 28px;
	min-height: 28px;
	max-height: 28px;
	font-size: 14px;
	font-weight: 600;
}
QPushButton#btnCantidad:hover {
	border-color: #899B83;
	color: #899B83;
}
QPushButton#btnCantidad:disabled {
	color: #B5B4AE;
	border-color: #EFEEE9;
}
QPushButton#btnQuitar {
	background: transparent;
	color: #B5B4AE;
	border: none;
	min-width: 22px;
	max-width: 22px;
	min-height: 22px;
	max-height: 22px;
	font-size: 12px;
}
QPushButton#btnQuitar:hover {
	color: #292A28;
}
QLabel#lblTotalTexto {
	color: #6B6A65;
	font-family: "Segoe UI";
	font-size: 13px;
}
QLabel#lblTotal {
	color: #292A28;
	font-family: Georgia;
	font-size: 26px;
}
</string>
